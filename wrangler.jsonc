{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "423-news",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "claudia.423.news/*",
      "zone_name": "423.news"
    }
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/sitemap.xml"
    ]
  },
  "previews": {},
  "main": "_worker.js"
}
