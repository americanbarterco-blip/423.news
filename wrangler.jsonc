{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "423-news",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "SUPABASE_ADMIN_FUNCTION_URL": "https://kdiwehqtezlhecxsoysj.supabase.co/functions/v1/admin"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {
    "vars": {
      "SUPABASE_ADMIN_FUNCTION_URL": "https://kdiwehqtezlhecxsoysj.supabase.co/functions/v1/admin"
    }
  }
}
